# Copy to backend/.env and adjust. Environment variables override this file.

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Season used when a request doesn't name one (default: the current year)
# DEFAULT_SEASON=2026

# Where the Jolpica response cache and FastF1's cache are stored
# CACHE_DIR=./f1_cache

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Precomputed race analysis: run the scheduler in this API process (set false
# on all but one worker), and hours after a race's start to precompute it
PRECOMPUTE_ENABLED=true
PRECOMPUTE_DELAY_HOURS=5

# Running API that `python -m jobs.precompute` delegates to when the store is locked
# API_URL=http://127.0.0.1:8000

# Seasons FastF1 can load lap/telemetry data for (comma-separated). Other
# seasons get an immediate 503. Empty = always try (e.g. if F1 reopens access).
TELEMETRY_SEASONS=2021,2022
